{
  "name": "lakeline-for-databricks",
  "version": "0.1.2",
  "private": true,
  "description": "Chrome/Edge MV3 extension that shows estimated Databricks costs inside the workspace.",
  "license": "Apache-2.0",
  "author": "Vivek Kovvuru",
  "homepage": "https://vivkv07.github.io/lakeline-for-databricks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivkv07/lakeline-for-databricks.git"
  },
  "bugs": {
    "url": "https://github.com/vivkv07/lakeline-for-databricks/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test local/test-*.mjs",
    "test:browser": "node --test --test-concurrency=1 local/browser/test-*.mjs",
    "test:edge": "E2E_CHANNEL=msedge node --test --test-concurrency=1 local/browser/test-*.mjs",
    "helper": "node local/server.mjs --open",
    "fixture": "node local/server.mjs --fixture-only",
    "package": "node scripts/package.mjs",
    "video:capture": "node local/video/capture.mjs",
    "video:music": "node video/music/compose.mjs",
    "video:render": "node video/composer/render.mjs",
    "store:assets": "node store/assets/build.mjs"
  },
  "devDependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1"
  }
}
