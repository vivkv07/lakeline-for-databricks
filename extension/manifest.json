{
  "manifest_version": 3,
  "name": "Lakeline for Databricks",
  "short_name": "Lakeline",
  "version": "0.1.0",
  "description": "Databricks cost estimates, run monitoring and a Genie side panel. Independent project; not affiliated with Databricks, Inc.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "identity",
    "sidePanel"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*.cloud.databricks.com/*",
    "https://*.azuredatabricks.net/*",
    "https://*.gcp.databricks.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Lakeline for Databricks",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:8766/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"
  }
}
